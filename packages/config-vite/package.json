{
    "name": "@moon7/config-vite",
    "version": "0.1.1",
    "author": "Munir Hussin <profoundseven@gmail.com>",
    "contributors": [],
    "license": "UNLICENSED",
    "description": "Base Vite config for Moon7 projects",
    "keywords": [
        "vite",
        "vite-config"
    ],
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./globals": {
            "types": "./types/globals.d.ts"
        },
        "./*": "./dist/*.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rimraf dist",
        "prepublishOnly": "pnpm lint-ci && pnpm build",
        "lint": "run-p lint:*",
        "lint:type": "tsc --noEmit",
        "lint:code": "eslint",
        "lint:format": "prettier --check \"src/**/*\"",
        "lint:files": "ls-lint --config ../../.ls-lint.yml",
        "lint:spell": "cspell lint --no-progress --show-suggestions --show-context src/**/*.{ts,vue}",
        "lint-ci": "run-s lint-ci:*",
        "lint-ci:type": "tsc --noEmit && echo 'lint type passed!'",
        "lint-ci:code": "eslint --quiet && echo 'lint code passed!'",
        "lint-ci:format": "prettier --check --log-level error \"src/**/*\" && echo 'lint format passed!'",
        "lint-ci:files": "ls-lint --config ../../.ls-lint.yml && echo 'lint files passed!'",
        "fix": "pnpm fix:code && pnpm fix:format",
        "fix:code": "eslint --fix",
        "fix:format": "prettier --write \"src/**/*\""
    },
    "dependencies": {
        "@quasar/vite-plugin": "1.10.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "npm-run-all2": "^8.0.4",
        "vue": "^3.5.22",
        "vue-router": "^4.6.3"
    },
    "devDependencies": {
        "@ls-lint/ls-lint": "^2.3.1",
        "@moon7/config-eslint": "workspace:^",
        "@types/node": "^22.18.13",
        "@vitest/coverage-v8": "^3.2.4",
        "cspell": "^9.2.2",
        "eslint": "^9.39.0",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.0",
        "typescript": "^5.9.3",
        "vite": "^7.1.12",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    }
}
