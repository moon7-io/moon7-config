{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "globalEnv": [],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint-ci": {
            "dependsOn": ["^lint-ci"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^test"]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "fix": {
            "dependsOn": ["^fix"]
        },
        "e2e": {
            "dependsOn": ["^build"]
        }
    }
}
